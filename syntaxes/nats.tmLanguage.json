{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NATS",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#separators"
    },
    {
      "include": "#variable-definitions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#headers"
    },
    {
      "include": "#subjects"
    },
    {
      "include": "#json-blocks"
    },
    {
      "include": "#invalid-commands"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nats",
          "match": "^\\s*#.*$"
        },
        {
          "name": "comment.line.double-slash.nats",
          "match": "^\\s*//.*$"
        }
      ]
    },
    "variable-definitions": {
      "patterns": [
        {
          "match": "^\\s*(@)([^=]+)(=)(.*)$",
          "captures": {
            "1": { "name": "keyword.operator.nats" },
            "2": { "name": "variable.other.nats" },
            "3": { "name": "keyword.operator.nats" },
            "4": {
              "patterns": [
                { "include": "#variables" },
                { "name": "string.unquoted.nats", "match": ".+" }
              ]
            }
          }
        }
      ]
    },
    "headers": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z0-9-]+)(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.other.header.nats" },
            "2": { "name": "punctuation.separator.key-value.nats" },
            "3": {
              "patterns": [
                { "include": "#variables" },
                { "name": "string.unquoted.nats", "match": ".+" }
              ]
            }
          }
        }
      ]
    },
    "invalid-commands": {
      "patterns": [
        {
          "match": "^\\s*(?!(REPLY|REQUEST|SUBSCRIBE|PUBLISH|JSPUBLISH|JSCONSUME)\\b)[A-Z]{2,}\\b.*$",
          "name": "invalid.illegal.nats"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nats",
          "match": "\\b(REPLY|REQUEST|SUBSCRIBE|PUBLISH|JSPUBLISH|JSCONSUME)\\b"
        }
      ]
    },
    "subjects": {
      "patterns": [
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_.]*\\b(?=\\s|$)",
          "patterns": [
            { "include": "#variables" },
            { "name": "entity.name.function.nats", "match": ".+" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nats",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.nats",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#string-interpolation"
            }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "include": "#variables"
        },
        {
          "name": "variable.other.nats",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_.]*"
        },
        {
          "name": "meta.embedded.expression.nats",
          "begin": "\\$\\{",
          "end": "\\}",
          "contentName": "source.js",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        }
      ]
    },
    "json-blocks": {
      "patterns": [
        {
          "name": "meta.block.json.nats",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#variables"
            },
            {
              "match": "\"[^\"]*(\\{\\{[^}]+\\}\\})[^\"]*\"",
              "captures": {
                "1": { "name": "variable.other.nats" }
              }
            },
            {
              "include": "source.json"
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.nats",
          "match": "\\{\\{[^}]+\\}\\}"
        }
      ]
    },
    "separators": {
      "patterns": [
        {
          "name": "meta.separator.nats",
          "match": "^#{3,}\\s*$"
        }
      ]
    }
  },
  "scopeName": "source.nats"
}
